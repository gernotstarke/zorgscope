# Copy to .env (git-ignored) for `make app`. Never commit real values.
# --- upstream credentials (read-only scopes) ---
# Fine-grained PAT: Issues/PRs/Actions read on monitored repos (+ notifications), or classic `repo` + `notifications`.
GITHUB_TOKEN=
# plausible.io → Settings → API keys (Stats API).
PLAUSIBLE_API_KEY=
# --- app secrets ---
# Reserved for future passkey sessions: ≥ 32 random bytes, e.g. `openssl rand -hex 32`.
SESSION_SECRET=
ENROLL_TOKEN=
# ≥ 32 random bytes; bearer token for native/API clients until passkeys land.
ZORGSCOPE_API_TOKEN=
# Base64-encoded 32-byte key for API-managed upstream secrets, e.g. `openssl rand -base64 32`.
ZORGSCOPE_CONFIG_KEY=
# --- local convenience ---
# dev is localhost-only; production currently uses token (passkey is the target).
AUTH_MODE=dev
LOG_LEVEL=info
ZORGSCOPE_CONFIG=/app/config/zorgscope.yaml
# Overrides server.base_url locally.
ZORGSCOPE_BASE_URL=http://localhost:8080
