# Local development. Copy to .env (git-ignored) and fill in.
#   cp deploy/env.example .env

# --- required -----------------------------------------------------------------------------------
# Sign in with GitHub (FR-8.3): the OAuth App registered for THIS environment. Register one App per
# environment, because an App has exactly one callback URL:
#   local:      callback http://localhost:8080/auth/callback
#   production: callback https://zorgscope.fly.dev/auth/callback  (set these as Fly secrets)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# A classic personal access token with the security_events scope and nothing else (ADR-0015): the
# issue and pull request queries need no scope, Dependabot alerts need this one. Its owner must be
# able to see the alerts (an admin of each repository).
GITHUB_TOKEN=

# --- optional ------------------------------------------------------------------------------------
# systems42-org's meta and systems42 are private, which GITHUB_TOKEN cannot read (ADR-0017). A
# fine-grained token, resource owner systems42-org, expiring within a year, repository access
# "Only select repositories": systems42.org-site, systems42, meta; repository permissions, all
# read-only: Issues, Pull requests, Dependabot alerts (Metadata is added by GitHub). Without it those
# two repositories fail and everything else still arrives. Any owner can have one:
# GITHUB_TOKEN_<OWNER>, the owner upper-cased and every other character an underscore.
GITHUB_TOKEN_SYSTEMS42_ORG=

# Point the adapter, and the OAuth App's authorize/token endpoints, at the fake GitHub (cmd/fakesources) instead of the
# real services. Empty means the real GitHub.
# GITHUB_BASE_URL=http://host.docker.internal:9090
# GITHUB_OAUTH_BASE_URL=http://host.docker.internal:9090

LOG_LEVEL=info
