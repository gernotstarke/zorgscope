# Local development. Copy to .env (git-ignored) and fill in. In production these are Fly secrets.
#
#   cp deploy/env.example .env
#   openssl rand -base64 32      # for each of the two zorgscope secrets

# --- required -----------------------------------------------------------------------------------
# Sign-in token for the browser session (FR-8.3). At least 32 characters.
ZORGSCOPE_TOKEN=
# Bearer secret cron-job.org sends to POST /api/refresh (FR-5.1). At least 32 characters.
# Deliberately separate from ZORGSCOPE_TOKEN: the cron service can trigger a refresh and nothing else.
REFRESH_SECRET=

# --- upstream credentials -----------------------------------------------------------------------
# A source without its credential is disabled and says so on its tile (FR-8.2 AC2), rather than
# failing every refresh run. Fill in only what you want to watch.
GITHUB_TOKEN=
SLACK_WEBHOOK_URL=

# --- database -----------------------------------------------------------------------------------
# Locally these are set by deploy/compose.yml and can stay empty here.
TURSO_URL=
TURSO_AUTH_TOKEN=

# --- optional -----------------------------------------------------------------------------------
# Point the adapters at `make fakes` instead of the real services (FR-9.2).
# GITHUB_BASE_URL=http://host.docker.internal:9090
LOG_LEVEL=info
