# Copy to .env (git-ignored) for `make app`. Never commit real values.
# --- upstream credentials (read-only scopes) ---
GITHUB_TOKEN=            # fine-grained PAT: Issues/PRs/Actions read on monitored repos (+ notifications) or classic `repo` + `notifications`
PLAUSIBLE_API_KEY=       # plausible.io → Settings → API keys (Stats API)
TODOIST_TOKEN=           # Todoist → Settings → Integrations → Developer → API token
# --- app secrets ---
SESSION_SECRET=          # ≥ 32 random bytes, e.g. `openssl rand -hex 32`
ENROLL_TOKEN=            # one-time passkey enrolment token, e.g. `openssl rand -hex 24`
# --- local convenience ---
AUTH_MODE=dev            # dev = no passkey locally (only honoured for http://localhost*); use `passkey` in production
LOG_LEVEL=info
ZORGSCOPE_CONFIG=/app/config/zorgscope.yaml
ZORGSCOPE_BASE_URL=http://localhost:8080   # overrides server.base_url locally
