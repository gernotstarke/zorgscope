# Local development. Copy to .env (git-ignored) and fill in. In production these are Fly secrets.
#
#   cp deploy/env.example .env
#   openssl rand -base64 32      # for REFRESH_SECRET

# --- required -----------------------------------------------------------------------------------
# Sign in with GitHub (FR-8.3): the OAuth App registered for THIS environment. Register one App per
# environment, because an App has exactly one callback URL:
#   local:      callback http://localhost:8080/auth/callback
#   production: callback https://zorgscope.fly.dev/auth/callback  (set these as Fly secrets)
# The client secret also seeds the session cookie's signing key: rotating it signs everyone out.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Optional: where the authorize and token endpoints live. Empty means https://github.com.
# GITHUB_OAUTH_BASE_URL=http://host.docker.internal:9090
# Bearer secret cron-job.org sends to POST /api/refresh (FR-5.1). At least 32 characters.
# Deliberately separate from the OAuth pair: the cron service can trigger a refresh and nothing else.
REFRESH_SECRET=

# --- upstream credentials -----------------------------------------------------------------------
# A source without its credential is disabled and says so above the list (FR-8.2 AC2), rather than
# failing every refresh run. Fill in only what you want to watch.
GITHUB_TOKEN=
SLACK_WEBHOOK_URL=

# --- database -----------------------------------------------------------------------------------
# Locally these are set by deploy/compose.yml and can stay empty here.
TURSO_URL=
TURSO_AUTH_TOKEN=

# --- optional -----------------------------------------------------------------------------------
# Point the adapters at `make fakes` instead of the real services (FR-9.2).
# GITHUB_BASE_URL=http://host.docker.internal:9090
LOG_LEVEL=info
